{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist-lib/types",
    "rootDir": "src",
    "verbatimModuleSyntax": true
  },
  "include": ["src/index.ts", "src/utils/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
